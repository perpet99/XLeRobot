<mujoco model="so100_scene">
  <include file="./so100.xml"/>

  <option timestep="0.002" gravity="0 0 -9.80665" integrator="implicitfast"/>

  <statistic center="0.0 0 0.2" extent="0.6"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-25" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.15 0.2"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- pick-and-place target: a block tall enough that the fingers can close
         around its upper half without the fingertips reaching the floor -->
    <body name="block" pos="0.10 -0.20 0.030">
      <freejoint name="block_free"/>
      <geom name="block_geom" type="box" size="0.010 0.010 0.030" rgba="1.0 0.331 0.0 1"
            friction="1.5 0.05 0.002" mass="0.03"/>
    </body>
  </worldbody>

  <keyframe>
    <!-- arm at the teleop home pose, block standing on the floor -->
    <key name="home" qpos="0 1.5715 1.6055 -0.0340 0 0.6  0.10 -0.20 0.030 1 0 0 0"
         ctrl="0 1.5715 1.6055 -0.0340 0 0.6"/>
  </keyframe>
</mujoco>
